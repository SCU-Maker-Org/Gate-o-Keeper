# HTTP Server
HTTP_ADDR=0.0.0.0:8080
INTERNAL_HTTP_ADDR=0.0.0.0:8081
RUST_LOG=info,locker_backend=debug
COOKIE_SECURE=true
ALLOW_DEV_DEFAULTS=false
ALLOW_INSECURE_OIDC_HTTP=false
TRUSTED_PROXIES=

# Database & Redis
DATABASE_URL=sqlite:///data/locker.db?mode=rwc
REDIS_URL=redis://redis:6379

# JWT Signing (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-64-char-random-secret-key-for-user-jwt-signing

# Authentik SSO Container (local/prod)
AUTHENTIK_PG_PASS=change-me-authentik-pg-pass
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key-50-chars-minimum
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost.localdomain
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-admin-password
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-authentik-bootstrap-api-token

# Authentik OIDC (Backend + Frontend runtime integration)
AUTHENTIK_ISSUER=http://localhost:9000/application/o/locker/
AUTHENTIK_DISCOVERY_URL=http://authentik-server:9000/application/o/locker/.well-known/openid-configuration
AUTHENTIK_CLIENT_ID=locker-client-id
AUTHENTIK_CLIENT_SECRET=locker-client-secret
AUTHENTIK_ADMIN_GROUPS=locker-admins
# Frontend OIDC login parameters (baked into the frontend bundle at build time)
VITE_AUTHENTIK_AUTHORIZE_URL=http://localhost:9000/application/o/authorize/
VITE_AUTHENTIK_CLIENT_ID=locker-client-id
VITE_AUTHENTIK_ADMIN_URL=
# Optional: allowlist IPs for Back-Channel Logout / Authentik Webhook (comma-separated, empty = allow any)
BACKCHANNEL_LOGOUT_ALLOWED_IPS=
# Authentik Webhook & Core API Sync (defaults: webhook secret falls back to INTERNAL_MQTT_SECRET; API token falls back to AUTHENTIK_BOOTSTRAP_TOKEN)
AUTHENTIK_WEBHOOK_SECRET=
AUTHENTIK_API_TOKEN=

# MQTT / EMQX (MQTTS + mTLS)
MQTT_HOST=broker
# Broker address advertised to adapters via GET /api/adapter/status (must be device-reachable)
MQTT_PUBLIC_ENDPOINT=mqtts://127.0.0.1:8883
MQTT_PORT=8883
MQTT_CLIENT_ID=locker-backend
MQTT_USERNAME=locker-backend
MQTT_PASSWORD=backend-internal-mqtt-secret
MQTT_CA_CERT=/certs/ca.crt
MQTT_CLIENT_CERT=/certs/backend.crt
MQTT_CLIENT_KEY=/certs/backend.key
MQTT_BROKER_API_URL=http://broker:18083/api/v5
MQTT_BROKER_API_KEY=locker-emqx-api-key
MQTT_BROKER_API_SECRET=locker-emqx-api-secret
INTERNAL_MQTT_SECRET=change-me-internal-mqtt-hook-secret
